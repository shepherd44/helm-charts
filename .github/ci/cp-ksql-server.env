# What CI has to know about this chart, sourced by .github/workflows/ci.yaml so that
# the workflow itself names no chart. $CHART is this chart's path from the repo root.
#
# This sits here rather than under charts/<name>/ on purpose: ct treats any file that
# changes inside a chart directory as a chart change and demands a version bump, and a
# CI-only edit is not worth publishing a release for.
#
# Every variable is optional; a chart with no file here is rendered with plain defaults
# and is not installed on a cluster.

# Extra `helm template` flags for the render, kubeconform and image passes.
#
# The monitors are not in ci/*-values.yaml because ct installs those on a cluster with no
# Prometheus Operator CRDs; kubeconform validates them here against the CRD catalog
# instead, which is the only place they can be checked at all. Same for the HTTPRoute:
# neither cluster this chart is aimed at has the Gateway API installed.
RENDER_ARGS=(
  --set external.enabled=true
  --set metrics.serviceMonitor.enabled=true
  --set metrics.prometheusRule.enabled=true
  --set 'metrics.prometheusRule.rules[0].alert=KsqlServerDown'
  --set 'metrics.prometheusRule.rules[0].expr=up == 0'
  --set ingress.enabled=true
  --set 'ingress.hosts[0].host=ksqldb.example.com'
  --set 'ingress.hosts[0].paths[0].path=/'
  --set httpRoute.enabled=true
  --set 'httpRoute.parentRefs[0].name=ci-gateway'
)

# Run `ct install` for this chart, once per ci/*-values.yaml file. Worth doing now that
# there is a readiness probe: without one `--wait` passes as soon as a container process
# exists, whether or not ksqlDB ever reached its command topic.
INSTALL=true

# Applied before the install and waited on. ksqlDB writes its command topic to Kafka
# before it will serve anything, so an install without this proves nothing.
FIXTURES=(.github/ci/kafka.yaml)
FIXTURE_WAIT=(-n kafka rollout status deployment/kafka --timeout=300s)
