# What CI has to know about this chart, sourced by .github/workflows/ci.yaml so that
# the workflow itself names no chart. $CHART is this chart's path from the repo root.
#
# This sits here rather than under charts/<name>/ on purpose: ct treats any file that
# changes inside a chart directory as a chart change and demands a version bump, and a
# CI-only edit is not worth publishing a release for.
#
# Every variable is optional; a chart with no file here is rendered with plain defaults
# and is not installed on a cluster.

# Extra `helm template` flags for the render, kubeconform and image passes. Both of
# these add a container, and the image-annotation gate only sees an image it renders.
RENDER_ARGS=(
  --set metrics.enabled=true
  --set volumePermissions.enabled=true
)

# Run `ct install` for this chart, once per ci/*-values.yaml file. ci/minimal-values.yaml
# installs a one-shard, no-persistence topology; the default two shards would double the
# pods for no extra coverage.
INSTALL=true
