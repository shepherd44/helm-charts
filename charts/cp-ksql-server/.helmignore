# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
# CI inputs, not part of the package. Anchored on purpose: a bare `tests/` would also
# match templates/tests/, which is where a helm test hook lives, and silently drop it
# from the tarball.
/ci/
/tests/
