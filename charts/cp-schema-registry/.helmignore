# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
# Not part of the package: CI fixtures, template unit tests, agent state.
# Anchored with a leading slash — a bare `tests/` would also drop
# templates/tests/, i.e. the helm test hook, out of the tarball.
/ci/
/tests/
/.omc/
